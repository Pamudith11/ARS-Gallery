rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'OMGd04Xx0AXMw4m45ATzLR48BOE2'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Clients can only be signed in through Google.
    function isGoogleClient() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // ---------- Public site content (anyone can read, only admin can write) ----------

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is number;
      allow delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'category', 'title', 'description', 'images', 'createdAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 12
        && request.resource.data.createdAt is number;
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'price', 'features', 'featured', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.price is string
        && request.resource.data.price.size() <= 60
        && request.resource.data.features is list
        && request.resource.data.features.size() <= 30
        && request.resource.data.featured is bool
        && request.resource.data.createdAt is number;
      allow delete: if isAdmin();
    }

    // ---------- Users ----------

    match /users/{userId} {
      allow get, list: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update: if (isGoogleClient() || isAdmin())
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'lastSeenAt'
        ])
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if isAdmin();
    }

    // ---------- Bookings ----------

    match /bookings/{bookingId} {
      allow create: if isGoogleClient()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'service', 'date', 'time',
          'notes', 'accountEmail', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.service is string
        && request.resource.data.service.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }
  }
}
