rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Master Admin UID or user listed in /admins collection
    function isAdmin() {
      return signedIn() && (
        request.auth.uid == 'ZVtWb2w79UdZy4FjiUY59PTNI6A3'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isClient() {
      return signedIn();
    }

    // ---------- Admins whitelist ----------
    match /admins/{adminId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Categories ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Albums ----------
    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Packages ----------
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ---------- Bookings ----------
    match /bookings/{bookingId} {
      allow create: if isClient() && request.resource.data.uid == request.auth.uid;
      allow get, list, update, delete: if isAdmin();
    }
  }
}
